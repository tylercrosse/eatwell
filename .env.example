# --- OpenRouter (required for /api/analyze) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-3-flash-preview
# Optional attribution headers shown on openrouter.ai
APP_TITLE=Calorie Tracker
APP_REFERER=http://localhost:5173

# --- USDA FoodData Central (grounds the text-description estimate) ---
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Leave blank to fall back to an ungrounded pure-LLM estimate.
USDA_API_KEY=

# --- Storage paths (defaults are fine for local dev) ---
DB_PATH=data/app.db
PHOTOS_DIR=data/photos

# --- Serving ---
# When true, FastAPI also serves the built PWA from web/dist (single-service deploy).
# Set false to run frontend separately (Vite dev server / static host).
SERVE_STATIC=false
STATIC_DIR=web/dist
# Comma-separated origins allowed by CORS (frontend dev servers / tunnels).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (Google sign-in) ---
# OAuth 2.0 Web client id from Google Cloud Console (APIs & Services > Credentials).
# Add your app origins to the client's "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Seed for the `invites` table, applied at startup. The TABLE is the source of truth, not
# this value: adding someone needs no redeploy, and deleting an entry here does NOT remove
# their access — revoke the invite instead. Every email that already has an account is also
# grandfathered in, so switching to a guest list can't lock out existing users.
# Blank now means CLOSED (it used to mean "allow anyone"); use ALLOW_OPEN_SIGNUP to open up.
ALLOWED_EMAILS=you@example.com,partner@example.com
# Skip the guest list entirely and admit anyone a provider verifies. Leave false for a beta.
ALLOW_OPEN_SIGNUP=false
# Long random secret signing your session cookies. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value
# The owner account: its first login adopts pre-auth (pre-login) data, and it's the only
# account that may invite others. Blank = off, and nobody can invite.
OWNER_EMAIL=you@example.com
# Set true when serving over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# --- Email sign-in (magic link) ---
# "console" prints the link + code to stdout instead of sending — the default, so the flow is
# testable with no mailbox and a half-configured deploy fails visibly. "smtp" sends for real.
EMAIL_PROVIDER=console
# Gmail: enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords. Sending through Google's own servers keeps the
# message DKIM-signed and DMARC-aligned, which an HTTP provider can't do without a verified
# domain. EMAIL_FROM must equal SMTP_USER or Google rewrites the sender and alignment breaks.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=Calorie Tracker
# Absolute origin that magic links point at. MUST be set in any deploy: links are built from
# this and never from the request Host header, which would let an attacker harvest tokens.
APP_BASE_URL=http://localhost:5173
# Sign-in token lifetime, typed-code guess cap, and per-hour request limits.
LOGIN_TOKEN_TTL_SECONDS=900
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_REQUESTS_PER_EMAIL_PER_HOUR=5
LOGIN_REQUESTS_PER_IP_PER_HOUR=20
# Header carrying the real client IP behind a proxy. On Fly set this to fly-client-ip, or
# every request looks like the proxy's address and the per-IP limit locks out everyone at
# once. Blank locally, so a spoofable header is never trusted in dev.
TRUSTED_CLIENT_IP_HEADER=

# --- Local QA auth (optional; local hosts only, no frontend UI) ---
# When enabled, POST /api/auth/qa from localhost with {"account":"qa-loss","secret":"..."}
# to set the same httpOnly session cookie as Google login. Do not enable for deploys.
QA_AUTH_ENABLED=false
QA_AUTH_SECRET=
QA_AUTH_ACCOUNTS=qa-loss|qa-loss@example.test|QA Loss,qa-gain|qa-gain@example.test|QA Gain,qa-sporadic|qa-sporadic@example.test|QA Sporadic
